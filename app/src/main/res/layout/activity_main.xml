<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pullIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="8dp"
        android:text="Pull to refresh"
        android:textColor="#8A94A6"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.marcel.hyperliquid.PullScrollView
        android:id="@+id/pullScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Holdings vs the last close"
                android:textColor="#E8ECF1"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/asOfText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Hyperliquid perps"
                android:textColor="#8A94A6"
                android:textSize="13sp" />

            <Button
                android:id="@+id/refreshButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_accent"
                android:padding="12dp"
                android:text="Refresh"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/search_bg"
                    android:hint="Search markets to track"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#E8ECF1"
                    android:textColorHint="#5A6478"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/clearSearchButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:minWidth="48dp"
                    android:text="✕"
                    android:textColor="#8A94A6"
                    android:textSize="16sp"
                    android:visibility="gone" />

            </LinearLayout>

            <TextView
                android:id="@+id/searchStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8A94A6"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="No holdings tracked yet, search above to add one"
                android:textColor="#8A94A6"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/banner_error"
                android:clickable="true"
                android:padding="12dp"
                android:textColor="#FF8A96"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Perpetual prices, not the stocks or ETFs themselves. BTC is the IBIT proxy. No Hyperliquid market, so no weekend read: TQQQ, CURE, SATA, VUG, XLU, MLPX."
                    android:textColor="#8A94A6"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </com.marcel.hyperliquid.PullScrollView>
</LinearLayout>
